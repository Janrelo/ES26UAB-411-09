'Params
  title Consultar menús
  skinparam backgroundColor transparent
  skinparam actorStyle Hollow
  skinparam actorBackgroundColor business
  skinparam boundaryBackgroundColor business
  skinparam controlBackgroundColor business
  skinparam entityBackgroundColor business

'Participants
  actor "Usuari no Registrat" as U
  boundary Interfaç as I
  control Gestor as G
  entity Cuiner as C
  entity Plat as P
  entity Usuari as USR

'Seqüència
  U -> I : veureMenús()
  activate I
  I -> G : obtenirMenús()
  deactivate I
  activate G
  G -> USR : obtenirDades()
  activate USR
  USR -> G : <<return>>
  deactivate USR
loop filtrar cuiners i plats
  G -> C : obtenirCuiners()
  activate C
  C -> G : <<return>>
  deactivate C
  G -> P : obtenirPlats()
  activate P
  P -> G : <<return>>
  deactivate P
end
  G -> I : mostrarMenús()
  deactivate G
opt Cercar menús
  U -> I : cercarMenús()
  activate I
  I -> G : obtenirMenús()
  deactivate I
  activate G
  G -> USR : obtenirDades()
  activate USR
  USR -> G : <<return>>
  deactivate USR
loop filtrar cuiners i plats
  G -> C : obtenirCuiners()
  activate C
  C -> G : <<return>>
  deactivate C
  G -> P : obtenirPlats()
  activate P
  P -> G : <<return>>
  deactivate P
end
  G -> I : mostrarMenús()
  deactivate G
end
opt Informació menús
  U -> I : consultarPlat()
  activate I
  I -> G : consultarPlat()
  deactivate I
  activate G
  G -> P : getInformació()
  activate P
  P -> G : <<return>>
  deactivate P
  G -> I : mostrarInformació()
end
