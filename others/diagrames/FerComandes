'Params
  title Fer comandes
  skinparam backgroundColor transparent
  skinparam actorStyle Hollow
  skinparam actorBackgroundColor business
  skinparam boundaryBackgroundColor business
  skinparam controlBackgroundColor business
  skinparam entityBackgroundColor business

'Participants
  actor Client as CLI
  boundary Interfaç as I
  control Gestor as G
  entity Comanda as C
  entity Cuiner as CUI
  entity Repartidor as REP
  entity Compte as CC

'Seqüència
  CLI -> I : ferComanda()
  activate I
  I -> G : ferComanda()
  deactivate I
  activate G
loop for comanda.pendent in comandes
  G -> C : getEstat()
  activate C
  C -> G : <<return>>
  deactivate C
break if numPendents >= 3
  G -> I : mostrarError()
  destroy G
end
end
loop for plat in comanda
  G -> C : getPlats()
  activate G
  activate C
  C -> G : <<return>>
  deactivate C
end
  G -> I : mostrarPlats()
  G -> I : demanarConfirmació()
  activate I

alt Reservar comanda
  CLI -> I : confirmarOperació()
  I -> G : getConfirmació()
  deactivate I
else Cancel·lar operació
  CLI -> I : acabarOperació()
  activate I
  I -> G : acabarOperació()
  deactivate I
  destroy G
end

  G -> CUI : getDisponibilitat()
  activate G
  activate CUI
  CUI -> G : <<return>>
  deactivate CUI
opt Cuiner no disponible
  G -> I : demanarConfirmació()
  activate I
alt Reservar comanda
  CLI -> I : confirmarOperació()
  I -> G : confirmarOperació()
  deactivate I
else Cancel·lar operació
  CLI -> I : acabarOperació()
  activate I
  I -> G : acabarOperació()
  deactivate I
  destroy G
end
end
  G -> I : demanarPagament()
  activate I
  activate G
  CLI -> I : pagarComanda()
  I -> G : validarInformació()
  deactivate I
opt Dades no vàlides
  G -> I : mostrarError()
alt Reinserir dades
  CLI -> I : pagarComanda()
  activate I
  I -> G : validarInformació()
  deactivate I
else Cancel·lar operació
  CLI -> I : acabarOperació()
  activate I
  I -> G : acabarOperació()
  deactivate I
  destroy G
end
end
  G -> I : demanarRecollida()
  activate G
  activate I
  CLI -> I : seleccionarRecollida()
  I -> G : getRecollida()
  deactivate I
  G -> C : actualitzarComanda()
  activate C
  C -> C : actualitzarComanda()
  deactivate C
  G -> C : guardarComanda()
  activate C
  C -> C : guardarComanda()
  deactivate C

opt Recollida pel repartidor
  G -> REP : encarregarRepartidor()
  activate REP
  REP -> REP : encarregarRepartidor()
  deactivate REP
  G -> CC : ingressarRepartidor()
  activate CC
  CC -> CC : ingressarRepartidor()
  deactivate CC
end
alt Reservar comanda
  G -> CUI : reservarComanda()
  deactivate G
  activate CUI
  CUI -> CUI : reservarComanda()
  deactivate CUI
  ...
  CUI -> I : acceptarComanda()
  activate I
  I -> G : acceptarComanda()
  deactivate I
  activate G
else Encarregar comanda
  G -> CUI : encarregarComanda()
  activate CUI
  CUI -> CUI : encarregarComanda()
  deactivate CUI
end
  G -> CC : ingressarCuiner()
  activate CC
  CC -> CC : ingressarCuiner()
  deactivate CC
  G -> CC : afegirPunts()
  activate CC
  CC -> CC : afegirPunts()
  deactivate CC
  G -> I : mostrarPunts()
  deactivate G
