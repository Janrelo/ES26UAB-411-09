'Params
  title Valorar comanda
  skinparam backgroundColor transparent
  skinparam actorStyle Hollow
  skinparam actorBackgroundColor business
  skinparam boundaryBackgroundColor business
  skinparam controlBackgroundColor business
  skinparam entityBackgroundColor business

'Participants
  actor Client as CLI
  boundary Interfaç as I
  control Gestor as G
  entity Comanda as C
  entity Valoració as V

'Seqüència
  CLI -> I : seleccionarComanda()
  activate I
  I -> G : confirmarComanda()
  deactivate I
  activate G
  G -> C : confirmarComanda()
  activate C
  C -> G : <<return>>
  deactivate C
opt Comanda valorada
  G -> I : mostrarError()
  destroy G
end
  G -> I : demanarDades()
  activate G
  activate I
  CLI -> I : entrarDades()
  I -> G : entrarDades()
  deactivate I
  G -> G : confirmarDades()
opt Informació incompleta
  G -> I : mostrarError()
loop while incorrecte
  CLI -> I : entrarDades()
  activate I
  I -> G : entrarDades()
  deactivate I
  G -> G : confirmarDades()
end
end
  G -> V : setValoració()
  deactivate G
  activate V
  V -> V : setValoració()
  deactivate V
